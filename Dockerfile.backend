FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000
RUN apt-get update \
    && apt-get install -y --no-install-recommends gdal-bin libgdal-dev libspatialindex-dev curl \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt
COPY alembic.ini /app/alembic.ini
COPY scripts /app/scripts
COPY backend /app/backend
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.getenv('PORT', '8000') + '/api/health')"
CMD ["sh", "/app/scripts/deploy-backend-render.sh"]
