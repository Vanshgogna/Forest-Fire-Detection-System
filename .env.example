# FireSight local development and production deployment template.
# Keep real secrets in Render/Vercel secret managers or a local untracked .env file.

# Application
APP_NAME=FireSight AI Environmental Intelligence API
API_VERSION=v1
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
PORT=8000
DATA_MODE=live

# Backend security
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_EMAIL=officer@firesight.ai
DEMO_LOGIN_PASSWORD=development-demo-password-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
RATE_LIMIT_PER_MINUTE=180
MAX_REQUEST_BODY_BYTES=1048576
REPLAY_WINDOW_SECONDS=300

# Database and cache
# Local Docker example:
# DATABASE_URL=postgresql+psycopg://firesight:firesight@localhost:5432/firesight
# Neon/Supabase-style managed PostgreSQL example:
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DATABASE?sslmode=require&channel_binding=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0

# Frontend
# Local development:
VITE_API_URL=http://localhost:8000/api
# Production frontend host setting example:
# VITE_API_URL=https://your-backend-host.example/api

# Artifact paths
DATASET_DIR=datasets
MODEL_ARTIFACT_DIR=backend/artifacts/models
UPLOAD_DIR=backend/artifacts/uploads
RASTER_ARTIFACT_DIR=backend/artifacts/rasters
CACHE_ARTIFACT_DIR=backend/artifacts/cache
REPORT_ARTIFACT_DIR=backend/artifacts/reports
DATA_ARCHIVE_DIR=backend/artifacts/data-archive
DATA_CHECKPOINT_DIR=backend/artifacts/data-checkpoints

# Weather provider
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=
WEATHER_CACHE_SECONDS=300
WEATHER_REQUEST_TIMEOUT=8
WEATHER_RECENT_MINUTES=30
WEATHER_STALE_MINUTES=120
WEATHER_TEMPERATURE_DIFFERENCE_WARNING_C=3
WEATHER_TEMPERATURE_DIFFERENCE_INVESTIGATE_C=6
WEATHER_HUMIDITY_DIFFERENCE_WARNING_PERCENT=15
WEATHER_HUMIDITY_DIFFERENCE_INVESTIGATE_PERCENT=30
WEATHER_WIND_DIFFERENCE_WARNING_KMH=10
WEATHER_WIND_DIFFERENCE_INVESTIGATE_KMH=20
WEATHER_RAINFALL_DIFFERENCE_WARNING_MM=2
WEATHER_RAINFALL_DIFFERENCE_INVESTIGATE_MM=8

# NASA FIRMS hotspots
FIRMS_ENABLED=false
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_PRODUCT=VIIRS_SNPP_NRT
FIRMS_LOOKBACK_HOURS=24
FIRMS_MAX_RECORDS=500
FIRMS_REQUEST_TIMEOUT=10
FIRMS_REGION_BUFFER_DEGREES=0.5
FIRMS_RETRY_ATTEMPTS=2
FIRMS_RETRY_BACKOFF_SECONDS=0.5
FIRMS_REFRESH_INTERVAL_MINUTES=180
HOTSPOT_MAX_AGE_HOURS=24

# Sentinel-2 / Copernicus
SENTINEL_ENABLED=false
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_BASE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
SENTINEL_CATALOG_URL=
SENTINEL_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1
SENTINEL_PRODUCT_TYPE=S2MSI2A
SENTINEL_LOOKBACK_DAYS=14
SENTINEL_MAX_CLOUD_COVER=40
SENTINEL_REQUEST_TIMEOUT=30
SENTINEL_MAX_SCENE_SIZE_MB=512
SENTINEL_TEMP_DIR=backend/artifacts/rasters/tmp/sentinel
SENTINEL_RETRY_ATTEMPTS=2
SENTINEL_RETRY_BACKOFF_SECONDS=1
SENTINEL_REFRESH_INTERVAL_HOURS=24
SENTINEL_ANALYSIS_RESOLUTION=20
SENTINEL_RASTER_MAX_MEMORY_MB=256
SENTINEL_PROCESSING_DIR=backend/artifacts/rasters/processed/sentinel
SENTINEL_MIN_VALID_PIXEL_PERCENT=40
SENTINEL_QUALITY_MASK_VERSION=6D-2-v1
SENTINEL_NDVI_PROCESSING_VERSION=6D-3-v1
VEGETATION_MAX_AGE_DAYS=5

# Legacy/manual hotspot URLs, only if explicitly used
MODIS_HOTSPOT_URL=
VIIRS_HOTSPOT_URL=

# Optional media/report storage
CLOUDINARY_URL=

# ML and alert configuration
CRITICAL_RISK_THRESHOLD=85
HIGH_RISK_THRESHOLD=70
PREDICTION_BATCH_SIZE_LIMIT=500
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=500

# Local Docker Compose database bootstrap
POSTGRES_USER=firesight
POSTGRES_PASSWORD=firesight
POSTGRES_DB=firesight
